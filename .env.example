# Agent GTD environment template.
#
# IMPORTANT: this file is NOT auto-loaded. The app reads os.environ directly
# (no python-dotenv, and start.sh/serve.sh don't source it). Export these vars
# into your shell before running the seed script or servers, e.g.:
#
#   set -a; source .env; set +a
#
# or use direnv / a systemd EnvironmentFile to do the same.

# JWT secret — change this in production
JWT_SECRET=dev-secret-change-me

# PostgreSQL connection (multi-user mode). If unset, the app falls back to
# zero-config local SQLite (single-user mode, auth disabled).
AGENT_GTD_DATABASE_URL=postgresql://user:password@localhost:5432/agent_gtd

# Extra hostname added to the CORS allowed origins as https://<HOSTNAME>.
# Needed for any deployment served from somewhere other than localhost.
# HOSTNAME=gtd.example.com

# --- MCP server configuration ---
# Remote mode: MCP tools call the web API via HTTP (no DB access needed)
# AGENT_GTD_URL=https://gtd.example.com
# AGENT_GTD_API_KEY=agtd_...
#
# Local mode: omit both vars above — MCP uses SQLite, no auth required
#
# Attribution name recorded on items/comments created via MCP. The dispatch
# worker sets this automatically for headless runs (e.g. claude-build-<id>);
# leave unset for interactive use.
# AGENT_GTD_AGENT_NAME=claude-build-12345678

# --- Remote dispatch service (optional) ---
# The dispatch service lives in the separate agent-gtd-dispatch repo
# (https://github.com/jason-weddington/agent-gtd-dispatch). Provision a host
# with its setup-dispatch-host.sh; for a single dev machine use single-user
# mode (no two-user split):
#   sudo --preserve-env=DISPATCH_SINGLE_USER DISPATCH_SINGLE_USER=1 ./setup-dispatch-host.sh --env-file <env-file>
# Then point DISPATCH_SERVICE_URL at that host (adapt host/port to your
# environment).
# DISPATCH_SERVICE_URL=http://<your-dispatch-host>:8100
# DISPATCH_SERVICE_API_KEY=changeme
# DISPATCH_DEFAULT_MAX_TURNS=100   # default when unset: 100
