# JWT secret — change this in production
JWT_SECRET=dev-secret-change-me

# PostgreSQL connection
AGENT_GTD_DATABASE_URL=postgresql://user:password@localhost:5432/agent_gtd

# --- MCP server configuration ---
# Remote mode: MCP tools call the web API via HTTP (no DB access needed)
# AGENT_GTD_URL=https://gtd.example.com
# AGENT_GTD_API_KEY=agtd_...
#
# Local mode: omit both vars above — MCP uses SQLite, no auth required

# --- Remote dispatch service ---
# DISPATCH_SERVICE_URL=http://pironman01:8100
# DISPATCH_SERVICE_API_KEY=changeme
# DISPATCH_DEFAULT_MAX_TURNS=50
